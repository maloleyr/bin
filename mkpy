#!/usr/bin/env bash
set -e
set -u
set -o pipefail

VERSION="1.0"

show_help() {
    cat <<EOF
Usage: $(basename "$0") [options] <script_name>

Create a starter Python script.

Options:
  -h, --help        Show this help message
  -v, --verbose     Enable verbose output
  -d, --description Add a short script description
  --version         Show version

Example:
  $(basename "$0") myscript.py
  $(basename "$0") -v -d "Nessus report parser" report_tool.py
EOF
}

VERBOSE=false
DESCRIPTION="Python starter script"

# ---- Argument Parsing ----
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -d|--description)
            DESCRIPTION="$2"
            shift 2
            ;;
        --version)
            echo "$(basename "$0") version $VERSION"
            exit 0
            ;;
        -*)
            echo "Unknown option: $1"
            exit 1
            ;;
        *)
            SCRIPT_NAME="$1"
            shift
            ;;
    esac
done

if [[ -z "${SCRIPT_NAME:-}" ]]; then
    echo "Error: You must specify a script name."
    show_help
    exit 1
fi

# Ensure .py extension
if [[ "$SCRIPT_NAME" != *.py ]]; then
    SCRIPT_NAME="${SCRIPT_NAME}.py"
fi

if [[ -e "$SCRIPT_NAME" ]]; then
    echo "Error: File '$SCRIPT_NAME' already exists."
    exit 1
fi

$VERBOSE && echo "[*] Creating Python stub: $SCRIPT_NAME"

# ---- Create Python Template ----
cat <<EOF > "$SCRIPT_NAME"
#!/usr/bin/env python3
"""
$DESCRIPTION
"""

import argparse
import logging
import sys

__version__ = "0.1.0"


def setup_logging(verbose: bool) -> None:
    level = logging.DEBUG if verbose else logging.INFO
    logging.basicConfig(
        level=level,
        format="%(asctime)s - %(levelname)s - %(message)s"
    )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="$DESCRIPTION"
    )

    parser.add_argument(
        "-v", "--verbose",
        action="store_true",
        help="Enable verbose output"
    )

    parser.add_argument(
        "--version",
        action="version",
        version=f"%(prog)s {__version__}"
    )

    return parser.parse_args()


def main() -> int:
    args = parse_args()
    setup_logging(args.verbose)

    logging.debug("Verbose mode enabled")
    logging.info("Script starting...")

    # ---- Your code starts here ----

    logging.info("Script completed successfully.")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\\nInterrupted by user.", file=sys.stderr)
        sys.exit(130)
EOF

chmod +x "$SCRIPT_NAME"

$VERBOSE && echo "[+] Created and made executable: $SCRIPT_NAME"

echo "Created: $SCRIPT_NAME. Opening in the default editor."

"$EDITOR" "$SCRIPT_NAME"
